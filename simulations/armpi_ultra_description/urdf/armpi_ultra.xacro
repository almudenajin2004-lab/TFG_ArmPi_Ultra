<?xml version="1.0" ?>
<robot name="armpi_ultra" xmlns:xacro="http://ros.org/wiki/xacro"> 

  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.0164042229877272 -2.04513182262022E-05 0.0219693028117164"/>
      <mass value="0.184970476929002"/>
      <inertia ixx="0.000205386861135714" ixy="1.35715925983726E-09" ixz="1.49085081540378E-06" iyy="0.000509205477303028" iyz="3.50510958146671E-11" izz="0.000701644432736427"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find armpi_ultra_description)/meshes//base_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find armpi_ultra_description)/meshes/base_link.STL"/>
      </geometry>
    </collision>
  </link>

  <link name="link1">
    <inertial>
      <origin rpy="0 0 0" xyz="0.00183675236262922 -0.00123349114372519 0.00540684297500725"/>
      <mass value="0.0495968437276972"/>
      <inertia ixx="2.12676208903481E-05" ixy="2.80399953258454E-09" ixz="1.31538362697273E-07" iyy="2.36267712831251E-05" iyz="1.30795197761443E-07" izz="4.23603771205122E-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find armpi_ultra_description)/meshes/link1.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find armpi_ultra_description)/meshes/link1.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint1" type="revolute">
    <origin rpy="0.0069813 0 -0.00032872" xyz="0.066956 -8.1218E-05 0.071005"/>
    <parent link="base_link"/>
    <child link="link1"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000" lower="-2.09" upper="2.09" velocity="10"/>
  </joint>

  <link name="link2">
    <inertial>
      <origin rpy="0 0 0" xyz="-8.1462418107997E-05 -0.0248959972917442 0.0530600779541552"/>
      <mass value="0.0256562517599134"/>
      <inertia ixx="1.11930874674043E-05" ixy="1.79466478804434E-09" ixz="4.31666137254955E-09" iyy="5.73918830225786E-06" iyz="1.80152801844581E-08" izz="8.3166482696753E-06"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find armpi_ultra_description)/meshes/link2.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find armpi_ultra_description)/meshes/link2.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint2" type="revolute">
    <origin rpy="0 0 0" xyz="0.0091468 0.025662 0.015922"/>
    <parent link="link1"/>
    <child link="link2"/>
    <axis xyz="-0.0010551 -0.99998 0.0068419"/>
    <limit effort="1000" lower="-2.09" upper="2.09" velocity="10"/>
  </joint>

  <link name="link3">
    <inertial>
      <origin rpy="0 0 0" xyz="1.11245115429898E-06 -0.0171534250124011 0.0473775325062425"/>
      <mass value="0.0539832963097135"/>
      <inertia ixx="9.16651733379202E-06" ixy="-1.43916290848519E-10" ixz="1.26376692708086E-09" iyy="1.02762907567637E-05" iyz="-1.51724247205094E-09" izz="3.54425807511496E-06"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find armpi_ultra_description)/meshes/link3.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find armpi_ultra_description)/meshes/link3.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint3" type="revolute">
    <origin rpy="-0.0067561 0.021887 0.0001759" xyz="-0.00022615 -0.0058452 0.10056"/>
    <parent link="link2"/>
    <child link="link3"/>
    <axis xyz="0.000275 -1 -0.00032517"/>
    <limit effort="1000" lower="-2.09" upper="2.09" velocity="10"/>
  </joint>

  <link name="link4">
    <inertial>
      <origin rpy="0 0 0" xyz="0.00395752511921098 -0.0195117566665206 0.0288166015169327"/>
      <mass value="0.0147032550628154"/>
      <inertia ixx="5.01387351753199E-06" ixy="-6.96359548521019E-09" ixz="-1.62523606651003E-07" iyy="3.89035590956844E-06" iyz="4.81048010932894E-09" izz="4.02580541552986E-06"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find armpi_ultra_description)/meshes/link4.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find armpi_ultra_description)/meshes/link4.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint4" type="revolute">
    <origin rpy="-0.00022696 -0.0072612 0" xyz="-1.6458E-05 1.6766E-05 0.094708"/>
    <parent link="link3"/>
    <child link="link4"/>
    <axis xyz="0.00040702 -1 -0.000213"/>
    <limit effort="1000" lower="-2.09" upper="2.09" velocity="10"/>
  </joint>

  <link name="link5">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.00012485429546084 5.63304909438861E-06 -0.0018618100016024"/>
      <mass value="0.00208534513323067"/>
      <inertia ixx="1.04715114419907E-07" ixy="-5.69033915905237E-12" ixz="7.6657305072005E-10" iyy="1.07236443877487E-07" iyz="-3.02203220598807E-10" izz="2.06733595380769E-07"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find armpi_ultra_description)/meshes/link5.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find armpi_ultra_description)/meshes/link5.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint5" type="revolute">
    <origin rpy="-0.003038 -0.011203 0" xyz="2.3581E-05 -0.0192 0.056107"/>
    <parent link="link4"/>
    <child link="link5"/>
    <axis xyz="-0.012028 0.0031146 -0.99992"/>
    <limit effort="1000" lower="-2.09" upper="2.09" velocity="10"/>
  </joint>

  <!-- end_effector_link: punto funcional (TCP) que usa MoveIt para la bola
       interactiva y el "tip_link" del grupo "arm" en la SRDF. Es un frame
       puro (sin malla ni colisión) para no confundirlo ni con link5 (el
       último motor) ni con la punta absoluta de la malla del tenedor.
       El padre sigue siendo link5 (no se toca la cinemática del robot);
       el offset es a lo largo de Z local, el mismo eje longitudinal por
       el que se monta tenedor_link con offset 0 (ver más abajo), así que
       este valor se mide igual desde la base del tenedor.
       Longitud total del tenedor (base en link5 -> punta de los dientes):
       0.15 m. Punto funcional deseado: línea media de los dientes, un
       poco retrasado respecto a la punta para que el planificador no
       intente colisionar justo el borde extremo -> 13.5/15 de la
       longitud = 0.135 m, dejando 0.015 m (1.5 cm) de margen hasta la
       punta física real. -->
  <link name="end_effector_link" />

  <joint name="end_effector_joint" type="fixed">
    <origin xyz="0.02 0 0.135" rpy="0 0 0"/>
    <parent link="link5"/>
    <child link="end_effector_link"/>
  </joint>

  <!-- Tenedor: herramienta terminal para asistencia en alimentación.
       Montado directamente sobre link5, offset 0 porque la malla de link5
       apenas sobresale (~0.17 mm) por encima de su propio origen; casi todo
       su volumen queda por debajo, así que offset 0 es lo que deja el tenedor
       pegado a la cara superior real de link5, sin hueco visible.
       (Antes se usó 0.0054388 m, tomado de un fichero de referencia pensado
       para el gripper mecánico antiguo, pero dejaba ~5 mm de hueco flotando.)
       El STL visual está exportado en milímetros, de ahí el scale 0.001; el resto
       de mallas de este fichero ya vienen en metros. La colisión usa la misma
       malla que el visual (antes se reutilizaba gripper_link_collision.stl, un
       casquillo de solo ~5.5 cm pensado para el gripper mecánico antiguo, que
       dejaba sin proteger la mitad de la pala del tenedor de ~15 cm).
       Masa/inercia: valor estimado, no hay datos CAD reales de esta pieza. -->
  <link name="tenedor_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.06"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find armpi_ultra_description)/meshes/tenedor_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find armpi_ultra_description)/meshes/tenedor_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="tenedor_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="link5"/>
    <child link="tenedor_link"/>
  </joint>

  <link name="rgb_camera_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.0118021523166905 -0.000540782293006269 0.00995705328357074"/>
      <mass value="0.00963635510803445"/>
      <inertia ixx="5.98204756678922E-06" ixy="6.68535029808548E-09" ixz="6.84156124804658E-10" iyy="6.63705685577627E-07" iyz="6.54661287243733E-10" izz="5.67360868792555E-06"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find armpi_ultra_description)/meshes/camera_connet_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <!-- Antes apuntaba a aurora_camera_joint.STL, que no existe (salia
             "Error retrieving file" al lanzar y la camara se quedaba sin
             colision). Se usa la misma malla que el visual. -->
        <mesh filename="file://$(find armpi_ultra_description)/meshes/camera_connet_link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="camera_connet_joint" type="fixed">
    <origin rpy="0 -1.5614 0" xyz="-0.040352 -0.019122 0.048005"/>
    <parent link="link4"/>
    <child link="rgb_camera_link"/>
  </joint>

  <!-- ============== CAMARA: frames de la lente + sensor simulado ==============
       rgb_camera_link es la pieza fisica de la camara Aurora930
       (camera_connet_link.STL), atornillada a link4 (el ultimo motor, ver
       meshes/README_MESHES.md), asi que se mueve con el brazo.
       En su malla la cara de las lentes esta en x = +0.0227 m y mira hacia +X
       (= eje longitudinal de link4, la misma direccion que el tenedor); las
       lentes estan centradas en y = 0, z = +0.010 m.

       camara_link: centro de la lente, convenio ROS (X adelante, Z arriba).
       camara_optical_frame: mismo punto, convenio de imagen (Z adelante,
       X derecha, Y abajo); es el frame_id de las imagenes simuladas.

       Nombres propios (no depth_cam_*_optical_frame) a proposito: el driver
       real de la camara (peripherals/launch/include/aurora930.launch.py)
       ya publica esos frames por TF estatico desde rgb_camera_link y, si el
       URDF los repitiera, chocarian dos padres en el arbol TF con el robot
       real. -->
  <link name="camara_link"/>
  <joint name="camara_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.0227 0 0.010"/>
    <parent link="rgb_camera_link"/>
    <child link="camara_link"/>
  </joint>

  <link name="camara_optical_frame"/>
  <joint name="camara_optical_joint" type="fixed">
    <origin rpy="${-pi/2} 0 ${-pi/2}" xyz="0 0 0"/>
    <parent link="camara_link"/>
    <child link="camara_optical_frame"/>
  </joint>

  <!-- Sensor de camara RGB-D para Gazebo Fortress (ignition-gazebo 6, el que
       corresponde a ROS 2 Humble; Gazebo Classic esta descontinuado). MoveIt
       y RViz ignoran este bloque; solo lo usa Gazebo
       (arm_moveit_config/launch/gazebo.launch.py). Gazebo publica en sus
       propios topics (camara/image, camara/depth_image, camara/points,
       camara/camera_info) y ese launch los pasa a ROS (ros_gz_bridge) con los
       MISMOS nombres que la camara real, para que el codigo de percepcion
       funcione igual en simulacion y con el robot:
         /depth_cam/rgb/image_raw, /depth_cam/rgb/camera_info,
         /depth_cam/depth/image_raw, /depth_cam/depth_registered/points
       Resolucion/FOV aproximados de la Aurora930 (640x480, ~70 grados).
       Las articulaciones (y por tanto /joint_states y el TF de la camara) las
       gestiona gz_ros2_control, ver config/armpi_ultra.urdf.xacro. -->
  <gazebo reference="camara_link">
    <sensor name="camara_rgbd" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>false</visualize>
      <topic>camara</topic>
      <ignition_frame_id>camara_optical_frame</ignition_frame_id>
      <camera>
        <horizontal_fov>1.2217</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>1.5</far>  <!-- toda la escena esta a menos de 1 m de la camara -->
        </clip>
      </camera>
    </sensor>
  </gazebo>

</robot>
